<Page x:Class="AquaCare.AddDiseaseLogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AquaCare"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddDiseaseLogPage" Loaded="Page_Loaded_1">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="🔍 Діагностика за симптомами" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Grid.Row="1" Padding="5">
                <ScrollViewer>
                    <ItemsControl x:Name="SymptomsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" 
                                          Tag="{Binding SymptomId}" 
                                          Checked="Symptom_Checked" 
                                          Unchecked="Symptom_Unchecked"
                                          Margin="0,5"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Button Grid.Row="2" Content="Знайти хворобу" Click="DiagnoseButton_Click" Margin="0,10" Height="30" Background="#FFADD8E6"/>

            <ListView x:Name="DiagnosisResultsList" Grid.Row="3" SelectionChanged="DiagnosisResultsList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,5">
                            <TextBlock Text="{Binding Disease.Name}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding MatchInfo}" Foreground="Green"/>
                            <TextBlock Text="{Binding Disease.Treatment}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <StackPanel Grid.Column="2">
            <TextBlock Text="📝 Новий запис в журнал" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Пацієнт (Риба або Рослина):"/>
            <ComboBox x:Name="PatientComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10"/>

            <TextBlock Text="Хвороба:"/>
            <ComboBox x:Name="DiseasesComboBox" DisplayMemberPath="Name" SelectedValuePath="DiseaseId" Margin="0,0,0,10"/>

            <TextBlock Text="Дата початку:"/>
            <DatePicker x:Name="StartDatePicker" Margin="0,0,0,10"/>

            <TextBlock Text="Нотатки / Лікування:"/>
            <TextBox x:Name="NotesBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

            <Button x:Name="AddPhotoButton" Content="📸 Додати фото" Click="AddPhotoButton_Click" Margin="0,0,0,10"/>
            <WrapPanel x:Name="PhotoPreviewPanel" Orientation="Horizontal" Margin="0,0,0,10"/>

            <Button x:Name="SaveBtn" Content="Зберегти запис" Click="SaveButton_Click" Height="40" Background="#0080FF"/>
        </StackPanel>
    </Grid>
</Page>
