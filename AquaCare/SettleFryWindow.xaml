<Window x:Class="AquaCare.SettleFryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AquaCare"
        mc:Ignorable="d"
        Title="Заселення малька" Height="350" Width="400" WindowStartupLocation="CenterScreen">
    <ScrollViewer>
        <StackPanel Margin="8">
        <TextBlock Text="🐟 Заселення у акваріум" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Text="Куди заселяємо?" FontWeight="SemiBold"/>
        <ComboBox x:Name="AquariumCombo" 
                  DisplayMemberPath="Name" 
                  SelectedValuePath="AquariumId" 
                  Margin="0,5,0,15" Padding="5"/>

        <TextBlock Text="Вид риби:" FontWeight="SemiBold"/>

        <TextBlock x:Name="AutoSpeciesText" 
                   Text="Вид: Визначається..." 
                   Foreground="Green" FontWeight="Bold" Margin="0,5,0,15" Visibility="Collapsed"/>

        <ComboBox x:Name="SpeciesCombo" 
                  DisplayMemberPath="SpeciesName" 
                  SelectedValuePath="SpeciesId" 
                  Margin="0,5,0,15" Padding="5" Visibility="Collapsed"/>

        <TextBlock Text="Кількість виживших (шт):" FontWeight="SemiBold"/>
        <TextBox x:Name="CountBox" Text="1" Margin="0,5,0,15" Padding="5"/>

        <TextBlock Text="Базове ім'я (напр. 'Мальок'):" FontWeight="SemiBold"/>
        <TextBox x:Name="NameBox" Text="Мальок" Margin="0,5,0,20" Padding="5"/>

        <Button Content="🚀 Заселити!" Click="Settle_Click" Height="40" Background="#FF90EE90" FontWeight="Bold"/>
    </StackPanel>
    </ScrollViewer>
</Window>
