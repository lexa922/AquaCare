<UserControl x:Class="AquaCare.SpeciesCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AquaCare"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="950" Width="950"
             
             Background="Transparent"
             x:Name="RootCard">
    <Border BorderBrush="#E0E0E0" 
            BorderThickness="1" 
            CornerRadius="5" 
            Background="White" 
            Margin="10">

        <Border.Effect>
            <DropShadowEffect ShadowDepth="1" Color="LightGray" Opacity="0.6" BlurRadius="5"/>
        </Border.Effect>
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Width="220" 
                    Height="150"
                    VerticalAlignment="Top"
                    Margin="0,0,10,0"
                    CornerRadius="3"
                    Background="{Binding CardColor, ElementName=RootCard}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CardColor, ElementName=RootCard}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Image Grid.Column="0" 
                   x:Name="CardImageElement"
                   Width="220" 
                   Height="150"
                   Stretch="UniformToFill"
                   VerticalAlignment="Top"
                   Margin="0,0,10,0"/>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding CardTitle, ElementName=RootCard}" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Margin="0,0,0,5"/>

                <TextBlock Text="{Binding CardDescription, ElementName=RootCard}" 
           TextWrapping="Wrap"
           TextTrimming="CharacterEllipsis"
           MaxHeight="110"
           FontSize="14"
           Foreground="#555"/>

                <ContentPresenter Content="{Binding AdditionalContent, ElementName=RootCard}"
                  Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>