<Window x:Class="AquaCare.EditFishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AquaCare"
        mc:Ignorable="d"
        Title="Редагування риби" Height="250" Width="300" WindowStartupLocation="CenterScreen">
    <ScrollViewer>
        <StackPanel Margin="20">
        <TextBlock Text="✏️ Редагування" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <TextBlock Text="Ім'я риби:"/>
        <TextBox x:Name="NameBox" Margin="0,5,0,15" Padding="5"/>

        <TextBlock Text="Стать:"/>
        <ComboBox x:Name="GenderCombo" Margin="0,5,0,20" Padding="5">
            <ComboBoxItem Content="Unknown" Tag="Unknown"/>
            <ComboBoxItem Content="Male" Tag="Male"/>
            <ComboBoxItem Content="Female" Tag="Female"/>
        </ComboBox>

        <Button Content="Зберегти" Click="Save_Click" Height="35" Background="#FF46A1FF" Foreground="White" FontWeight="Bold"/>
    </StackPanel>
    </ScrollViewer>
</Window>
