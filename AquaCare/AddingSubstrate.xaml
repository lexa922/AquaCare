<Page x:Class="AquaCare.AddingSubstrate"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AquaCare"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Loaded="Page_Loaded"
      Title="AddingSubstrate" Background="#FFE9E9E9">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Label Content="Назва грунту:" Grid.Row="1" Grid.Column="1"/>
        <TextBox x:Name="SubstrateName" Grid.Row="1" Grid.Column="2" Margin="0,0,0,10" Height="30"/>

        <Label Content="Тип грунту:" Grid.Row="2" Grid.Column="1"/>
        <ComboBox x:Name="SubstrateType" Grid.Row="2" Grid.Column="2" Margin="0,0,0,10" Height="30" DisplayMemberPath="TypeName" SelectedValuePath="SubstrateTypeId"/>

        <Label Content="Колір грунту:" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" />
        <ItemsControl x:Name="ColorPalette" Grid.Row="3" Grid.Column="2" Margin="5">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" Width="30" Height="30" Margin="3"
                    Background="{Binding ColorBrush}"
                    Cursor="Hand"
                    MouseLeftButtonDown="ColorRectangle_MouseLeftButtonDown">
                        <Border.ToolTip>
                            <ToolTip Content="{Binding Name}"/>
                        </Border.ToolTip>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Label Grid.Column="1" Grid.Row="4" Content="Розмір грунту:"/>
        <ComboBox x:Name="SubstrateSize"  Grid.Column="2" Grid.Row="4"/>
        <Button Content="Додати" Grid.Column="1" Grid.Row="5" Height="50" FontSize="16" Click="SaveButton_Click" Margin="0,10,0,0"/>
    </Grid>
</Page>
