<Window x:Class="AquaCare.PhotoGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AquaCare"
        mc:Ignorable="d"
        Title="Фотографії підміни води" Height="500" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#222">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ImagesControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10" BorderBrush="White" BorderThickness="2" CornerRadius="5">
                            <Image Source="{Binding ImagePath}" 
                                   Stretch="Uniform" 
                                   MaxHeight="400"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="NoPhotosText" 
                   Text="Фотографії відсутні" 
                   Foreground="White" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   FontSize="20" 
                   Visibility="Collapsed"/>
    </Grid>
</Window>
