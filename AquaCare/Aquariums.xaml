<Page x:Class="AquaCare.Aquariums"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AquaCare"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="Aquariums" Background="#FFE9E9E9">
    
    <Page.Resources>
        <local:StringToBrushConverter x:Key="StringToBrushConverter"/>
    </Page.Resources>

    <Grid Margin="20">
        <Label x:Name="AquariumsGreatingLabel" HorizontalAlignment="Left" Margin="223,28,0,0" VerticalAlignment="Top" Width="515" FontFamily="Calibri" FontSize="20" FontWeight="Bold"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AquariumsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:AquariumCard 
                Height="200"
                Margin="10,5" 
                AquariumName="{Binding Name}"
                VolumeText="{Binding VolumeDisplay}"
                SubstrateText="{Binding SubstrateName}"
                LightSchedule="{Binding LightInfo}"
                FishCountText="{Binding FishCount}"
                PlantCountText="{Binding PlantCount}"
                StatusText="{Binding StatusText}"
                StatusColorBrush="{Binding StatusColor, Converter={StaticResource StringToBrushConverter}}"
                WaterFreqText="{Binding WaterChangeFrequency}"
                Cursor="Hand"
                        MouseLeftButtonDown="AquariumCard_Click"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
