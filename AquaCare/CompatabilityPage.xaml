<Page x:Class="AquaCare.CompatabilityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AquaCare"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CompatabilityPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="White" Padding="15" CornerRadius="10" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="Gray" Opacity="0.2" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Нове правило сумісності" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                <WrapPanel>
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Вид риби №1:"/>
                        <ComboBox x:Name="Species1Combo" Width="180" DisplayMemberPath="SpeciesName" SelectedValuePath="FishSpecieId"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Вид риби №2:"/>
                        <ComboBox x:Name="Species2Combo" Width="180" DisplayMemberPath="SpeciesName" SelectedValuePath="FishSpecieId"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Рівень загрози:"/>
                        <ComboBox x:Name="LevelCombo" Width="150" SelectedIndex="0">
                            <ComboBoxItem Content="⛔ Критично (2)" Tag="2" FontWeight="Bold" Foreground="Red"/>
                            <ComboBoxItem Content="⚠️ Увага (1)" Tag="1" Foreground="Orange"/>
                            <ComboBoxItem Content="✅ Сумісні (0)" Tag="0" Foreground="Green"/>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="Примітка:" Margin="0,10,0,0"/>
                <TextBox x:Name="NoteBox" Height="40" Margin="0,5,0,10" BorderBrush="#FFCCCCCC" BorderThickness="1"/>

                <Button Content="💾 Зберегти" Click="AddRule_Click" 
                    HorizontalAlignment="Right" Width="120" Height="30"
                    Background="#2196F3" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="Список правил" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="2" x:Name="RulesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
              GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Вид 1" Binding="{Binding Species1Name}" Width="*"/>
                <DataGridTextColumn Header="Вид 2" Binding="{Binding Species2Name}" Width="*"/>

                <DataGridTemplateColumn Header="Рівень" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding LevelColor}" CornerRadius="4" Padding="5">
                                <TextBlock Text="{Binding LevelText}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Примітка" Binding="{Binding Notes}" Width="2*"/>

                <DataGridTemplateColumn Header="Дії" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🗑" Click="DeleteRule_Click" 
                                Background="Transparent" BorderThickness="0" Foreground="Red" FontSize="16" Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
