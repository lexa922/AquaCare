<Page x:Class="AquaCare.Plant"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AquaCare"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="Plant" Background="#FFE9E9E9">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
        <ItemsControl x:Name="PlantItemsControl">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:SpeciesCard
            CardTitle="{Binding Name}"
            CardDescription="{Binding Description}"
            CardImagePath="{Binding CoverPath}"
            MouseLeftButtonDown="SpeciesCard_MouseLeftButtonDown" Cursor="Hand">

                        <local:SpeciesCard.AdditionalContent>
                            <StackPanel Margin="0,5,0,0">
                                <TextBlock FontSize="12" Foreground="Gray">
                        <Run Text="Сумісні типи грунтів:"/>
                        <Run Text="{Binding SoilInfo}"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="Gray">
                        <Run Text="Світло:"/>
                        <Run Text="{Binding LightInfo}"/>
                                </TextBlock>
                            </StackPanel>
                        </local:SpeciesCard.AdditionalContent>

                    </local:SpeciesCard>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</Page>
