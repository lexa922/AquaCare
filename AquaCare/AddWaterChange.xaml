<Page x:Class="AquaCare.AddWaterChange"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AquaCare"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="AddWaterChange">

    <Grid Background="#F5F5F5">
        <Border Background="White" 
                CornerRadius="10" 
                Padding="30" 
                Margin="50" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" 
                          ShadowDepth="2" 
                          Direction="270" 
                          Color="#BBBBBB" 
                          Opacity="0.5"/>
            </Border.Effect>
            <StackPanel Width="350">
                <TextBlock Text="Нова підміна води" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Margin="0,0,0,20" 
                           HorizontalAlignment="Center"
                           Foreground="#333"/>

                <TextBlock Text="Дата:" 
                           Foreground="Gray" 
                           Margin="0,0,0,5"/>
                <DatePicker x:Name="ChangeDatePicker" 
                            Margin="0,0,0,15" 
                            Height="30"/>

                <TextBlock Text="Об'єм підміненої води (літрів):" 
                           Foreground="Gray" 
                           Margin="0,0,0,5"/>
                <TextBox x:Name="VolumeTextBox" 
                         Height="30" 
                         Margin="0,0,0,15"
                         Padding="5"
                         PreviewTextInput="VolumeTextBox_PreviewTextInput"/>
                <TextBlock Text="Фотографії (необов'язково):" 
                           Foreground="Gray" 
                           Margin="0,0,0,5"/>
                
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="Обрані файли:" VerticalAlignment="Center" Foreground="#555"/>
                    <Button x:Name="SelectImagesButton" 
                            Grid.Column="1"
                            Content="📂 Обрати фото" 
                            Padding="10,5"
                            Click="SelectImagesButton_Click"/>
                </Grid>

                <ListBox x:Name="SelectedImagesList" 
                         Height="80" 
                         Margin="0,0,0,20" 
                         BorderBrush="#DDD" 
                         BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📷 "/>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="CancelButton" 
                            Content="Скасувати" 
                            Width="100" 
                            Height="35" 
                            Margin="0,0,10,0"
                            Background="#DDDDDD"
                            Foreground="Black"
                            BorderThickness="0"
                            Click="CancelButton_Click"/>
                    
                    <Button x:Name="SaveButton" 
                            Content="Зберегти" 
                            Width="100" 
                            Height="35"
                            Background="#007ACC"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
