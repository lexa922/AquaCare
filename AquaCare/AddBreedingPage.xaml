<Page x:Class="AquaCare.AddBreedingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AquaCare"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddBreedingPage" Loaded="Page_Loaded_1">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

            <Border Background="White" CornerRadius="10" Padding="20" Margin="20" 
                    HorizontalAlignment="Center" VerticalAlignment="Top" Width="500" Loaded="Border_Loaded">

                <StackPanel>
                    <TextBlock Text="❤️ Реєстрація нересту" FontSize="22" FontWeight="Bold" 
                               Foreground="#FF46A1FF" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <TextBlock Text="Дата події:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <DatePicker x:Name="SpawnDatePicker" Margin="0,0,0,15" Padding="5" Height="30"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="♂️ Тато:" FontWeight="SemiBold" Foreground="#1976D2" Margin="0,0,0,5"/>
                            <ComboBox x:Name="FatherCombo" 
                                      DisplayMemberPath="DisplayName" 
                                      SelectedValuePath="Id"
                                      Height="30" Padding="5" SelectionChanged="FatherCombo_SelectionChanged"/>
                            <Button Content="Невідомий" Click="ClearFather_Click" 
                                    FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0" 
                                    Background="Transparent" BorderThickness="0" Foreground="Gray" Cursor="Hand"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="♀️ Мама:" FontWeight="SemiBold" Foreground="#E91E63" Margin="0,0,0,5"/>
                            <ComboBox x:Name="MotherCombo" 
                                      DisplayMemberPath="DisplayName" 
                                      SelectedValuePath="Id"
                                      Height="30" Padding="5" SelectionChanged="MotherCombo_SelectionChanged"/>
                            <Button Content="Невідома" Click="ClearMother_Click" 
                                    FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0" 
                                    Background="Transparent" BorderThickness="0" Foreground="Gray" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Кількість потомства (шт):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="CountBox" Text="0" PreviewTextInput="NumberValidationTextBox" 
                             Height="30" Padding="5" Margin="0,0,0,15"/>

                    <TextBlock Text="Фотозвіт:" FontWeight="SemiBold" Margin="0,5,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="📷 Додати фото" Click="AddPhoto_Click" Padding="10,5" Margin="0,0,10,0"/>
                        <TextBlock x:Name="PhotoCountText" Text="Обрано: 0" VerticalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                    <ListBox x:Name="PhotosList" Height="70" ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                             BorderThickness="1" BorderBrush="#EEEEEE" Margin="0,0,0,15">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" Height="60" Margin="5"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Результат / Нотатки:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="OutcomeBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" 
                             Padding="5" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"
                             BorderBrush="#FFCCCCCC"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
                        <Button Content="Скасувати" Click="Cancel_Click" 
                                Width="100" Height="35" Margin="0,0,10,0" Background="White" BorderBrush="#FFCCCCCC"/>

                        <Button Content="Зберегти" Click="Save_Click" 
                                Width="120" Height="35" Background="#FF46A1FF" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
