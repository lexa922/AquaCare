<Page x:Class="AquaCare.AquariumDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="Деталі Акваріума"
      Loaded="Page_Loaded"
      KeepAlive="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock x:Name="TankNameText" Text="Назва Акваріума" FontSize="28" FontWeight="Bold" Foreground="#333"/>
                <TextBlock x:Name="TankInfoText" Text="50 л | Ґрунт: Пісок" FontSize="16" Foreground="Gray" Margin="2,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ 🐟 Риба" Width="100" Height="35" Margin="0,0,10,0" Click="AddFish_Click"/>
                <Button Content="+ 🌿 Рослина" Width="100" Height="35" Margin="0,0,10,0" Click="AddPlant_Click"/>
                <Button Content="📒 + Підміна води" Width="130" Height="35" Click="AddWaterChange_Click"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1">

            <TabItem Header="Риби">
                <DataGrid x:Name="FishGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="10" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ім'я" Binding="{Binding FishName}" Width="*"/>
                        <DataGridTextColumn Header="Вид" Binding="{Binding Species.SpeciesName}" Width="*"/>
                        <DataGridTextColumn Header="Стать" Binding="{Binding Gender}" Width="80"/>
                        <DataGridTextColumn Header="Розмір (Біо)" Binding="{Binding Species.BioLoadValue}" Width="100"/>
                        <DataGridTextColumn Header="Чи жива" Binding="{Binding IsAlive}" Width="100"/>
                        <DataGridTemplateColumn Header="Дії" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                        <Button Content="✏️" 
                        ToolTip="Редагувати (Ім'я/Стать)"
                        Tag="{Binding}" 
                        Click="EditFishButton_Click"
                        Margin="0,0,5,0" 
                        Width="30" Height="30"
                        Background="White" BorderBrush="Gray"/>

                                        <Button Content="🗑️" 
                        ToolTip="Видалити"
                        Tag="{Binding FishId}" 
                        Click="DeleteFishButton_Click"
                        Width="30" Height="30"
                        Background="#FFEBEE" BorderBrush="Red" Foreground="Red"/>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Рослини">
                <DataGrid x:Name="PlantsGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="10" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Вид" Binding="{Binding SpeciesName}" Width="*"/>
                        <DataGridTextColumn Header="Кількість" Binding="{Binding Quantity}" Width="100"/>
                        <DataGridTextColumn Header="Вимоги до світла" Binding="{Binding LightInfo}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Журнал обслуговування">
                <DataGrid x:Name="ChangesGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="10" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding ChangeDate}" Width="*"/>
                        <DataGridTextColumn Header="Об'єм підміни(л)" Binding="{Binding Volume}" Width="100"/>

                        <DataGridTemplateColumn Header="Фото" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="📷 Переглянути" 
                            Click="ViewPhotosButton_Click"
                            Margin="5"
                            Padding="10,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Список хворих">
                <Grid Background="#F5F5F5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" Padding="10" Margin="0,0,0,5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Додати запис:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="Gray"/>

                            <Button Click="AddFishDiseaseButton_Click" Margin="0,0,10,0" Padding="10,5" 
                        Background="#FFEB9C9C" BorderThickness="0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🐟 Риба" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Button Click="AddPlantDiseaseButton_Click" Padding="10,5" 
                        Background="#FFC9EB9C" BorderThickness="0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌿 Рослина" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <ListView x:Name="ActiveDiseasesList" Grid.Row="1" 
                  BorderThickness="0" Background="Transparent" 
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="10,5,10,5"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="8" BorderBrush="#DDDDDD" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="1" Opacity="0.1" BlurRadius="5"/>
                                    </Border.Effect>

                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" CornerRadius="5" ClipToBounds="True" Background="#F0F0F0" Height="150" Width="150">
                                            <Image Grid.Column="0" 
                                                Source="{Binding MainImagePath}"
                                                Width="150" Height="150" 
                                                Stretch="UniformToFill">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,150,150" RadiusX="5" RadiusY="5"/>
                                                </Image.Clip>
                                            </Image>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="15,0,10,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="{Binding TypeIcon}" FontSize="16" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding DiseaseName}" 
                                               FontSize="16" FontWeight="Bold" Foreground="#D32F2F"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding PatientName}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2"/>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Хворіє з: " Foreground="Gray" FontSize="12"/>
                                                <TextBlock Text="{Binding StartDate, StringFormat=dd.MM.yyyy}" Foreground="Gray" FontSize="12"/>
                                                <TextBlock Text=" (" Foreground="Gray" FontSize="12"/>
                                                <TextBlock Text="{Binding DurationInfo}" Foreground="#D32F2F" FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Text=")" Foreground="Gray" FontSize="12"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding TreatmentNotes}" 
                                           Margin="0,5,0,0" 
                                           Foreground="#555555" 
                                           FontStyle="Italic"
                                           TextTrimming="CharacterEllipsis" 
                                           MaxHeight="36"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">

                                            <Button Content="✏️" 
                                        ToolTip="Редагувати запис"
                                        Tag="{Binding}" 
                                        Click="EditDiseaseButton_Click"
                                        Width="35" Height="35" Margin="0,0,0,10"
                                        Background="White" BorderBrush="Gray" BorderThickness="1"
                                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                                            <Button Content="✅" 
                                        ToolTip="Позначити як здорового"
                                        Tag="{Binding DiseaseLogId}"
                                        Click="CureButton_Click"
                                        Width="35" Height="35"
                                        Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="1"/>
                                            <Button Content="💀" ToolTip="Загинув"
                                        Tag="{Binding DiseaseLogId}" Click="DeathButton_Click"
                                        Width="35" Height="35"
                                        Background="#FFEBEE" BorderBrush="#FF5252" BorderThickness="1" Foreground="Red"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="NoDiseasesPanel" Grid.Row="1" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Visibility="Collapsed">
                        <TextBlock Text="🎉" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="Всі мешканці здорові!" FontSize="18" Foreground="Gray" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Розмноження">
                <Grid Background="#F5F5F5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Content="+ Зареєструвати нерест" Click="AddBreeding_Click"
                Margin="10" HorizontalAlignment="Right"
                Background="#FF46A1FF" Foreground="White" Padding="10,5"/>

                    <ListView x:Name="BreedingList" Grid.Row="1" BorderThickness="0" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="8" Margin="10,5" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding StartDate, StringFormat=dd.MM.yyyy}" Foreground="Gray" FontSize="12"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                                <TextBlock Text="♂️" Foreground="#1976D2" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding MaleFish.FishName}" FontWeight="Bold"/>
                                                <TextBlock Text=" + " Margin="5,0"/>
                                                <TextBlock Text="♀️" Foreground="#E91E63" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding FemaleFish.FishName}" FontWeight="Bold"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding OffspringCount, StringFormat='Мальків: {0}'}" FontStyle="Italic"/>
                                            <TextBlock Text="{Binding Outcome}" TextTrimming="CharacterEllipsis" MaxWidth="300" Foreground="Gray"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                                            <Button Content="✏️" Tag="{Binding}" Click="EditBreeding_Click" Margin="0,0,5,0" Width="30" Height="30" 
                                                ToolTip="Редагувати" Background="White" BorderBrush="Gray"/>

                                            <Button Content="🏠" Tag="{Binding}" Click="SettleFry_Click" Margin="0,0,5,0" Width="30" Height="30" 
                                                ToolTip="Заселити виросших" Background="#E8F5E9" BorderBrush="Green"/>

                                            <Button Content="🗑️" Tag="{Binding BreedingLogId}" Click="DeleteBreeding_Click" Width="30" Height="30" 
                                                ToolTip="Видалити запис" Background="#FFEBEE" BorderBrush="Red" Foreground="Red"/>

                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="DeleteButton" Width="140" Height="40" Content="Видалити акваріум" Click="DeleteButton_Click" Background="#FFFF6464" Foreground="White"/>
        </StackPanel>
    </Grid>
</Page>
