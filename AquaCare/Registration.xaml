<Page x:Class="AquaCare.Registration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AquaCare"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="Registration" Background="#FFE9E9E9">

    <Grid>
        <Label Content="Реєстрація" HorizontalAlignment="Center" Margin="0,82,0,0" VerticalAlignment="Top" FontFamily="Arial" FontSize="36" FontWeight="Bold"/>
        <Label Content="Ім'я користувача:" HorizontalAlignment="Left" Margin="230,190,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Arial"/>
        <Label Content="Пароль:" HorizontalAlignment="Left" Margin="230,241,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Arial"/>
        <Label Content="Повторіть пароль:" HorizontalAlignment="Left" Margin="230,298,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Arial"/>
        <TextBox x:Name="UsernameTextBox" HorizontalAlignment="Left" Margin="397,193,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="186" Height="25"/>
        <PasswordBox x:Name="PasswordBox1" HorizontalAlignment="Left" Margin="397,245,0,0" VerticalAlignment="Top" Width="186" Height="25"/>
        <PasswordBox x:Name="PasswordBox2" HorizontalAlignment="Left" Margin="397,300,0,0" VerticalAlignment="Top" Width="186" Height="25"/>
        <Button Content="Зареєструватись" HorizontalAlignment="Left" Margin="383,364,0,0" VerticalAlignment="Top" Background="#FF46A1FF" Foreground="White" BorderBrush="#FFFFF9F9" BorderThickness="2,2,2,2" Cursor="Arrow" Width="200" Height="63"  FontFamily="Arial" FontSize="16" Click="Button_Click"/>
        <TextBox x:Name="ErrorTextBlock" HorizontalAlignment="Center" Margin="0,432,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="292" Height="67" Background="#FFE9E9E9" Foreground="#FFFF0808" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="Arial" FontSize="18" BorderBrush="#FFE9E9E9" IsEnabled="False" AllowDrop="False"/>

    </Grid>
</Page>
